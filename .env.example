# Copy to .env.local and fill in. Never commit .env.local.

# Server-only. Never expose as NEXT_PUBLIC_*.
RAINBET_API_KEY=

# Bearer token checked by app/api/cron/sync/route.ts.
CRON_SECRET=

DB_HOST=
DB_PORT=3306
DB_USER=
# Server-only. Never expose as NEXT_PUBLIC_*.
DB_PASSWORD=
DB_NAME=
# Only needed for hosts that require TLS (e.g. Aiven). Use ONE of:
# DB_SSL_CA_BASE64 - `base64 -w0 certs/aiven-ca.pem`. Use this on
#                    Netlify/Vercel/etc — multi-line PEM content reliably
#                    gets mangled by bulk/.env-import UIs; base64 is one
#                    line, nothing to mangle.
# DB_SSL_CA        - the CA cert's full PEM content, pasted as-is. Only
#                    safe where you can paste into a single-value field
#                    directly (not a bulk .env importer).
# DB_SSL_CA_PATH   - path to a local cert file, e.g. ./certs/aiven-ca.pem.
#                    Local dev only.
DB_SSL_CA_BASE64=
DB_SSL_CA=
DB_SSL_CA_PATH=

ADMIN_PASSWORD=

# Free key from https://slot.report/api/register (requires a dofollow link
# back to slot.report — see components/SiteFooter.tsx). Powers slot-name
# autocomplete in the Bonus Hunt admin form.
SLOT_REPORT_API_KEY=
