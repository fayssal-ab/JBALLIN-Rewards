# Copy to .env.local and fill in. Never commit .env.local.

# Server-only. Never expose as NEXT_PUBLIC_*.
RAINBET_API_KEY=

# Bearer token checked by app/api/cron/sync/route.ts.
CRON_SECRET=

DB_HOST=
DB_PORT=3306
DB_USER=
# Server-only. Never expose as NEXT_PUBLIC_*.
DB_PASSWORD=
DB_NAME=
# Only needed for hosts that require TLS (e.g. Aiven). Use ONE of:
# DB_SSL_CA      - the CA cert's full PEM content, pasted as-is. Set this on
#                  Netlify/Vercel/etc — a local file path won't exist on
#                  their servers.
# DB_SSL_CA_PATH - path to a local cert file, e.g. ./certs/aiven-ca.pem.
#                  Local dev only.
DB_SSL_CA=
DB_SSL_CA_PATH=

# Phase 7.
ADMIN_PASSWORD=
