# Copy to .env.local and fill in. Never commit .env.local.

# Server-only. Never expose as NEXT_PUBLIC_*.
RAINBET_API_KEY=

# Bearer token checked by app/api/cron/sync/route.ts.
CRON_SECRET=

DB_HOST=
DB_PORT=3306
DB_USER=
# Server-only. Never expose as NEXT_PUBLIC_*.
DB_PASSWORD=
DB_NAME=
# Only needed for hosts that require TLS (e.g. Aiven). Path to the
# provider's CA cert, e.g. ./certs/aiven-ca.pem.
DB_SSL_CA_PATH=

# Phase 7.
ADMIN_PASSWORD=
